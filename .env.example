POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_CONTAINER_NAME=polytech-postgres
POSTGRES_HOST_PORT=5432
POSTGRES_DB=polytech
POSTGRES_USER=polytech
POSTGRES_PASSWORD=change-me
POSTGRES_DATA_VOLUME=polytech-postgres-data

DATABASE_URL=postgresql+asyncpg://polytech:change-me@localhost:5432/polytech
API_DATABASE_URL=postgresql+asyncpg://polytech:change-me@db:5432/polytech
DB_ECHO=false

API_IMAGE_NAME=polytech-api:latest
API_CONTAINER_NAME=polytech-api
API_HOST_PORT=8000

FRONTEND_IMAGE_NAME=polytech-frontend:latest
FRONTEND_CONTAINER_NAME=polytech-frontend
FRONTEND_HOST_PORT=8080
VITE_API_BASE_URL=

RUZ_BASE_URL=https://ruz.spbstu.ru/api/v1/ruz/
RUZ_TIMEOUT=10.0

USER_COOKIE_NAME=polytech_user
USER_COOKIE_MAX_AGE=31536000
USER_COOKIE_SECURE=false
USER_COOKIE_SAMESITE=lax
